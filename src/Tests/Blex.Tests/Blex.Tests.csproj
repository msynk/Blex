<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Runs against every framework the packages ship for, so no TFM leg goes untested. -->
    <TargetFrameworks>$(BlexTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BLEX011 is intentionally triggered by a fixture that verifies value-returning actions. -->
    <NoWarn>$(NoWarn);BLEX011</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Blex\Blex.csproj" />
    <ProjectReference Include="..\..\Blex.Blazor\Blex.Blazor.csproj" />
    <ProjectReference Include="..\..\Blex.Maui\Blex.Maui.csproj" />
    <ProjectReference Include="..\..\Blex.Testing\Blex.Testing.csproj" />
    <ProjectReference Include="..\..\Blex.Generators\Blex.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
