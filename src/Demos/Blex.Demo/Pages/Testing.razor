        new("IReadOnlyList&lt;RecordedActionBlex&gt; Actions", "Everything recorded, in dispatch order."),
        new("RecordedActionBlex? Last", "The most recent action, or <code>null</code>."),
        new("int Count", "Number of recorded actions."),
        new("IReadOnlyList&lt;string&gt; Names", "The bare action names in order."),
        new("IReadOnlyList&lt;string&gt; QualifiedNames", "The qualified names in order."),
        new("bool Contains(string)", "Whether an action with that bare or qualified name was recorded."),
        new("int CountOf(string)", "How many times it was recorded."),
        new("void Clear()", "Empties the log - handy between arrange and act."),
    ];

    private static readonly IReadOnlyList<ApiTable.Row> RecordedRows =
    [
        new("IStoreBlex Store", "The originating store."),
        new("string ActionName / QualifiedName", "<code>\"Increment\"</code> and <code>\"counter/Increment\"</code>."),
        new("int Sequence", "The monotonic dispatch number."),
        new("JsonObject State", "The global state tree right after this action."),
        new("IReadOnlyList&lt;ActionArgBlex&gt; Args", "The captured arguments."),
    ];

    private static readonly IReadOnlyList<ApiTable.Row> ExtensionRows =
    [
        new("manager.RecordActions()", "Starts recording on any manager and returns the <code>ActionLogBlex</code>. Dispose to stop."),
        new("store.Snapshot()", "Alias for <code>SerializeState()</code>."),
        new("store.WaitForAsync(Func&lt;bool&gt;, TimeSpan?)", "Waits until the condition holds, re-checking on every store change. Throws <code>TimeoutException</code> after the timeout (default 5 s)."),
        new("store.CountNotifications(Action)", "Counts <code>StateChanged</code> notifications raised while the delegate runs."),
    ];

    private const string Plain = """
        [Fact]
        public void Increment_adds_the_step()
        {
            var store = new CounterStore();

            store.SetStep(5);
            store.Increment();

            Assert.Equal(5, store.Count);
            Assert.Equal(10, store.DoubleCount);
        }
        """;

    private const string Harness = """
        using Blex.Testing;

        [Fact]
        public void Increment_dispatches_one_action()
        {
            using var harness = TestHarnessBlex.For<CounterStore>();

            harness.Store.Increment();

            Assert.Equal(["Increment"], harness.Log.Names);
            Assert.Equal(1, harness.Snapshot()["Count"]!.GetValue<int>());
        }

        // For a store with dependencies, construct it yourself:
        using var harness = TestHarnessBlex.For(new WeatherStore(httpClient));
        """;

    private const string Log = """
        using var harness = TestHarnessBlex.For<CounterStore>();

        harness.Store.Increment();
        harness.Store.Increment();
        harness.Store.SetStep(3);

        Assert.Equal(3, harness.Log.Count);
        Assert.Equal(2, harness.Log.CountOf("Increment"));
        Assert.True(harness.Log.Contains("counter/SetStep"));
        Assert.Equal("SetStep", harness.Log.Last!.ActionName);

        // The state captured immediately after a specific action:
        var afterFirst = harness.Log.Actions[0].State;
        Assert.Equal(1, afterFirst["counter"]!["Count"]!.GetValue<int>());
        """;

    private const string Payload = """
        harness.Store.SetStep(5);

        var action = harness.Log.Last!;
        Assert.Equal("SetStep", action.ActionName);
        Assert.Single(action.Args);
        Assert.Equal("step", action.Args[0].Name);
        Assert.Equal(5, action.Args[0].Value);

        // A direct assignment records as "Set X", carrying the assigned value.
        harness.Store.Count = 42;
        Assert.Equal("Set Count", harness.Log.Last!.ActionName);
        Assert.Equal(42, harness.Log.Last!.Args[0].Value);
        """;

    private const string Effects = """
        [Fact]
        public async Task LoadUser_populates_the_user()
        {
            using var harness = TestHarnessBlex.For(new UserStore(new FakeApi()));

            await harness.Store.LoadUser(42);

            Assert.False(harness.Store.LoadUserIsLoading);
            Assert.Null(harness.Store.LoadUserError);
            Assert.Equal("Ada", harness.Store.User!.Name);
        }

        [Fact]
        public async Task LoadUser_reports_loading_while_in_flight()
        {
            using var harness = TestHarnessBlex.For(new UserStore(new SlowApi()));

            var pending = harness.Store.LoadUser(42);          // do not await yet
            Assert.True(harness.Store.LoadUserIsLoading);

            await pending;
            await harness.Store.WaitForAsync(() => !harness.Store.LoadUserIsLoading);
        }
        """;

    private const string EffectErrors = """
        [Fact]
        public async Task A_failing_effect_captures_the_exception()
        {
            using var harness = TestHarnessBlex.For(new UserStore(new ThrowingApi()));

            await harness.Store.LoadUser(42);   // never throws

            Assert.IsType<HttpRequestException>(harness.Store.LoadUserError);
        }

        [Fact]
        public async Task Cancelling_is_not_an_error()
        {
            using var harness = TestHarnessBlex.For(new UserStore(new SlowApi()));

            var pending = harness.Store.LoadUser(42);
            harness.Store.CancelLoadUser();
            await pending;

            Assert.Null(harness.Store.LoadUserError);   // our own cancellation is a normal outcome
        }
        """;

    private const string Notifications = """
        [Fact]
        public void An_action_notifies_once_however_many_fields_it_touches()
        {
            var store = new CounterStore();

            // OnApplyPreset assigns both Count and Step.
            var notifications = store.CountNotifications(() => store.ApplyPreset(10, 5));

            Assert.Equal(1, notifications);
        }
        """;

    private const string MiddlewareTest = """
        [Fact]
        public void A_filter_vetoes_the_action()
        {
            using var harness = TestHarnessBlex.WithFilter<CounterStore>(_ => false);

            harness.Store.Increment();

            Assert.Equal(0, harness.Store.Count);   // the mutation never ran
            Assert.Empty(harness.Log.Actions);      // and nothing was recorded
        }

        [Fact]
        public void The_audit_middleware_sees_every_action()
        {
            var audit = new AuditMiddleware();
            using var harness = TestHarnessBlex.WithMiddleware<CounterStore>(audit);

            harness.Store.Increment();

            Assert.Equal(["counter/Increment"], audit.Entries);
        }

        // More than one store, or a manager configured up front: build it yourself.
        [Fact]
        public void Two_stores_share_one_filter()
        {
            var manager = new ManagerBlex([new FilterMiddlewareBlex(ctx => ctx.Store.Name != "cart")]);
            manager.Register(new CartStore());
            manager.Register(new ProfileStore());
            using var log = manager.RecordActions();
            ...
        }
        """;

    private const string PersistenceTest = """
        private sealed class MemoryStorage : IStorageBlex
        {
            public Dictionary<string, string> Values { get; } = [];

            public ValueTask<string?> GetAsync(string key, CancellationToken ct = default)
                => new(Values.TryGetValue(key, out var v) ? v : null);

            public ValueTask SetAsync(string key, string value, CancellationToken ct = default)
            {
                Values[key] = value;
                return ValueTask.CompletedTask;
            }

            public ValueTask RemoveAsync(string key, CancellationToken ct = default)
            {
                Values.Remove(key);
                return ValueTask.CompletedTask;
            }
        }

        [Fact]
        public async Task State_round_trips_through_storage()
        {
            var storage = new MemoryStorage();
            var manager = new ManagerBlex();
            var store = new SettingsStore();
            manager.Register(store);

            await using var persistor = new StatePersistorBlex(manager, storage);
            await persistor.StartAsync();

            store.SetAccent("teal");
            await persistor.FlushAsync();

            Assert.Contains("teal", storage.Values["blex:settings"]);

            // A fresh store rehydrates from the same storage.
            var manager2 = new ManagerBlex();
            var store2 = new SettingsStore();
            manager2.Register(store2);
            await using var persistor2 = new StatePersistorBlex(manager2, storage);
            await persistor2.StartAsync();

            Assert.Equal("teal", store2.Accent);
        }
        """;

    private const string HistoryTest = """
        [Fact]
        public void Undo_restores_the_previous_state()
        {
            var manager = new ManagerBlex();
            var store = new CounterStore();
            manager.Register(store);

            using var history = new HistoryBlex(manager);
            history.Start();

            store.Increment();
            store.Increment();
            Assert.Equal(2, store.Count);

            history.Undo();
            Assert.Equal(1, store.Count);
            Assert.True(history.CanRedo);

            history.Redo();
            Assert.Equal(2, store.Count);
        }
        """;

    private const string Bunit = """
        [Fact]
        public void The_component_renders_the_current_count()
        {
            using var ctx = new Bunit.TestContext();
            ctx.Services.AddBlex();
            ctx.Services.AddBlexStore<CounterStore>();

            var component = ctx.RenderComponent<Counter>();
            var store = ctx.Services.GetRequiredService<CounterStore>();

            component.Find("button.increment").Click();

            Assert.Equal(1, store.Count);
            component.MarkupMatches("<p>Count: 1</p>*");
        }
        """;
