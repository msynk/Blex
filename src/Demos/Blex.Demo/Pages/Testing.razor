        new("TestHarnessBlex.For(store)", "Creates a harness around an already-constructed store - use this when the store has dependencies."),
        new("TestHarnessBlex.WithFilter&lt;TStore&gt;(predicate)", "A harness whose manager vetoes any action the predicate rejects. The shorthand for testing a store together with its guard rails."),
        new("TestHarnessBlex.WithMiddleware&lt;TStore&gt;(…)", "A harness whose manager runs the given middleware. Also accepts an already-constructed store."),
        new("TStore Store", "The store under test."),
        new("ManagerBlex Manager", "The manager backing the harness. Use it to add middleware assertions or extra subscriptions."),
        new("ActionLogBlex Log", "Records every dispatch."),
        new("JsonObject State", "The current global state tree."),
        new("JsonObject Snapshot()", "The current snapshot of the store under test."),
        new("void Dispose()", "Detaches the log."),
    ];

